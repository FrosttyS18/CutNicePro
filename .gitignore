# Dependências isoladas do projeto (recriáveis; ver docs/TOOLING.md)
.tooling/venvs/
.tooling/vendor/
.tooling/playwright/node_modules/
.tooling/playwright/package-lock.json
.tooling/docs-refs/
.tooling/npm-cache/

# Node
node_modules/

# Arquivos de trabalho das skills
.taste-skill/

# Log de auditoria dos hooks (runtime, não versionar)
.zcode/hooks/audit/

# Marker local do MCP attached (config de máquina — não publicar)
design/FIGCRAFT-ATTACHED.on

# Sistema
Thumbs.db
.DS_Store

# Backups locais do arquivo FigCraft (nao publicar)
design/backups/

# Builds do experimento (regeneráveis; app/.gitignore já cobre src-tauri/target)
experiments/clip-selection-ab/target/

# Saída de runtime do Playwright MCP: logs de console e snapshots de página
# podem conter dados pessoais (ex.: e-mail em snapshot de sessão externa).
.playwright-mcp/

# Modelos GGUF e runtimes copiados nos lares do experimento (artefatos de
# laboratório multi-GB; presença registrada por .sha256/relatórios)
experiments/clip-selection-ab/models/**/*.gguf
experiments/clip-selection-ab/models/**/bin/
experiments/clip-selection-ab/models/**/gpu/

# Cache Python das ferramentas
__pycache__/

# Saída transitória de testes
.tooling/test-output/
