  "typography": {
    "family": "Poppins",
    "license": "SIL Open Font License 1.1",
    "weights": {
      "regular": { "weight": 400, "use": "texto, descrições, transcrições" },
      "medium": { "weight": 500, "use": "labels, controles, tabs" },
